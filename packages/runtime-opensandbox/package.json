{
  "name": "@agework/runtime-opensandbox",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "infra:rebuild": "node scripts/infra.mjs rebuild",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "infra:logs": "node scripts/infra.mjs logs",
    "infra:health": "node scripts/infra.mjs health",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.8",
    "@nestjs/common": "^11.0.1"
  },
  "peerDependencies": {
    "@agework/runtime-sdk": "workspace:*"
  },
  "devDependencies": {
    "@agework/runtime-sdk": "workspace:*",
    "@swc/core": "^1.15.40",
    "@types/node": "^24.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  },
  "tsdown": {
    "entry": "src/index.ts",
    "format": "cjs",
    "platform": "node",
    "target": "node22",
    "fixedExtension": true,
    "sourcemap": true,
    "dts": {
      "sourcemap": true
    },
    "deps": {
      "skipNodeModulesBundle": true
    }
  }
}
