{
  "name": "@agework/runtime-sdk",
  "version": "0.0.1",
  "private": false,
  "main": "./dist/index.cjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@types/node": "^24.0.0",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  },
  "tsdown": {
    "entry": "src/index.ts",
    "format": "cjs",
    "platform": "node",
    "target": "node22",
    "fixedExtension": true,
    "sourcemap": true,
    "dts": {
      "sourcemap": true
    },
    "deps": {
      "skipNodeModulesBundle": true
    }
  }
}
