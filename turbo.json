{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": ["VITE_APP_BASE_PATH", "VITE_APP_API_CONTEXT"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/apps/server/.env*"
      ],
      "outputs": ["dist/**"]
    },
    "@agework/runtime-host#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/adapters/src/**",
        "$TURBO_ROOT$/packages/adapters/scripts/generate-codex-types.mjs"
      ],
      "outputs": [
        "dist/**",
        "!dist/node_modules/**",
        "!dist/package.json",
        "!dist/package-lock.json",
        "!dist/.sdk-install-stamp.json"
      ]
    },
    "server#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "!dist/agework-runtime/**"]
    },
    "package": {
      "dependsOn": ["build", "^package"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build", "^package"],
      "cache": false,
      "persistent": true
    }
  }
}
