{
  "name": "@agework/runtime",
  "version": "0.0.1",
  "private": true,
  "main": "./src/main.ts",
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "build": "esbuild src/main.ts src/runner.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --banner:js=\"var __createRequire = (await import('module')).createRequire; var require = __createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agework/providers": "workspace:*",
    "@agework/shared": "workspace:*",
    "@agework/worker": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  }
}
