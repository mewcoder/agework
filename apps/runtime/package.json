{
  "name": "@agework/runtime",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/host.cjs",
  "exports": {
    ".": {
      "types": "./src/host/runtime-host.ts",
      "default": "./dist/host.cjs"
    },
    "./host": {
      "types": "./src/host/runtime-host.ts",
      "default": "./dist/host.cjs"
    },
    "./cli": {
      "types": "./src/main.ts",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "pnpm build:worker && pnpm build:host",
    "prepare:codex-types": "node ../../packages/adapters/scripts/generate-codex-types.mjs",
    "prepare:test": "pnpm prepare:codex-types && pnpm --filter @agework/shared build && pnpm --filter @agework/runtime-sdk build && pnpm --filter @agework/runtime-docker build && pnpm --filter @agework/agent-sdk build && pnpm --filter @agework/agent-acp build",
    "build:worker": "pnpm build:worker:bundle",
    "build:worker:bundle": "pnpm prepare:codex-types && esbuild src/main.ts src/runner.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --external:@anthropic-ai/claude-agent-sdk --external:@openai/codex-sdk --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "sync:bundled-agent-deps": "pnpm exec tsx scripts/sync-bundled-agent-runtime.ts --write",
    "check:bundled-agent-deps": "pnpm exec tsx scripts/sync-bundled-agent-runtime.ts --check",
    "package:sdk": "pnpm check:bundled-agent-deps && node scripts/install-sdk-deps.mjs",
    "build:host": "esbuild src/host/runtime-host.ts --bundle --platform=node --target=node22 --format=cjs --external:@agework/runtime-sdk --outfile=dist/host.cjs",
    "package": "pnpm package:sdk",
    "typecheck": "pnpm check:bundled-agent-deps && pnpm prepare:codex-types && tsc --noEmit",
    "test": "pnpm prepare:test && vitest run"
  },
  "dependencies": {
    "@agework/adapters": "workspace:*",
    "@agework/agent-acp": "workspace:*",
    "@agework/agent-sdk": "workspace:*",
    "@agework/runtime-docker": "workspace:*",
    "@agework/runtime-sdk": "workspace:*",
    "@agework/shared": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "rxjs": "7.8.1",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@agework/runtime-opensandbox": "workspace:*"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  }
}
