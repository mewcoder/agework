{
  "name": "@agework/runtime",
  "version": "0.0.1",
  "private": true,
  "main": "./src/main.ts",
  "exports": {
    ".": "./src/main.ts",
    "./host": {
      "types": "./src/host/runtime-host.ts",
      "default": "./dist/host.cjs"
    }
  },
  "scripts": {
    "build": "pnpm build:worker && pnpm build:host",
    "build:worker": "esbuild src/main.ts src/runner.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --external:@anthropic-ai/claude-agent-sdk --external:@openai/codex-sdk --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" && node scripts/install-sdk-deps.mjs",
    "build:host": "esbuild src/host/runtime-host.ts --bundle --platform=node --target=node22 --format=cjs --external:@agework/providers --external:@agework/shared --outfile=dist/host.cjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @agework/providers build && vitest run"
  },
  "dependencies": {
    "@agework/providers": "workspace:*",
    "@agework/shared": "workspace:*",
    "@agework/worker": "workspace:*",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "typescript": "catalog:",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  }
}
