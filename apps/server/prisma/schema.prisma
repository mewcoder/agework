generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String          @id
  // username 一经设定不可修改：它用作工作空间目录名（见 WorkspaceService.resolveCreateRootPath /
  // ConfigService.getUserWorkspace），改名会导致已有目录路径与 username 脱钩。格式见 user-credential.ts。
  username           String          @unique
  // 展示名（昵称），可改，可为空。UI 展示时回退到 username。与 username（登录标识+路径，不可改）解耦。
  nickname           String?
  passwordHash       String
  role               String          @default("user")
  status             String          @default("active")
  mustChangePassword Boolean         @default(false)
  passwordKind       String          @default("user_set")
  passwordExpiresAt  DateTime?
  passwordUpdatedAt  DateTime?
  passwordResetAt    DateTime?
  passwordResetById  String?
  approvedAt         DateTime?
  approvedById       String?
  lastLoginAt        DateTime?
  sessionVersion     Int             @default(1)
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  workspaces         Workspace[]
  modelProviders     ModelProvider[]
  sessions           Session[]
  runtimeHosts       RuntimeHost[]
}

/// 服务端登录会话：承载 refresh token 生命周期。只存 refresh token 的 hash，
/// 不存明文；轮换、撤销、过期都在此表落地，使服务端可主动登出/失效。
model Session {
  id               String    @id
  userId           String
  // refresh token 的 SHA-256（token 本身高熵随机，无需 bcrypt）。唯一约束便于按 token 反查。
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkspaceDirectory {
  id          String    @id
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rootPath    String
  status      String    @default("ready")
  source      String    @default("managed")
  metadata    Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([rootPath])
}

model Workspace {
  id             String                  @id
  name           String
  gitUrl         String?
  // 创建时选定的 git 分支（clone 时 checkout）；非 git / 未选时为 null。创建后只读。
  gitBranch      String?
  description    String?
  // 创建时的一次性选择，不可改（要换 = 删了重建）。worker 复用粒度：
  // user（同用户项目共享）或 workspace（项目独享环境）。
  scope String
  // 执行方式（native / docker / opensandbox），创建时从 RuntimeHost 能力
  // 列表选定。必填；默认值只用于旧 nullable 列升级时回填，业务创建始终显式写入。
  runtimeType    String                  @default("native")
  // 绑定的 RuntimeHost（builtin 或 registered）；创建时写入，不可改（要换 = 删了重建）。
  // 必填——builtin RuntimeHost 保证每个 Workspace 创建时都能落到一个真实存在的行。
  // registered RuntimeHost 被注销（removedAt 有值）后行仍在，runtimeHostId 不变，
  // 但 Workspace 进入"RuntimeHost 已注销"状态，不能跑 run 直到重新绑定。
  runtimeHostId  String
  runtimeHost    RuntimeHost             @relation(fields: [runtimeHostId], references: [id], onDelete: Restrict)
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  directory      WorkspaceDirectory?
  conversations  Conversation[]

  @@index([userId])
  @@index([userId, deletedAt, createdAt])
  @@index([runtimeHostId])
}

model Conversation {
  id                String    @id
  title             String?
  status            String    @default("regular")
  runStatus         String    @default("idle")
  pendingUserAction String?
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  agentType         String    @default("claude")
  agentSessionId    String?
  agentModes        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  messages          Message[]
  runs              Run[]

  @@index([workspaceId, status, deletedAt, updatedAt])
  @@index([workspaceId, status, deletedAt, createdAt])
}

model Message {
  id             String
  conversationId String
  runId          String?
  parentId       String?
  format         String
  content        Json
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  run            Run?         @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@id([id, conversationId])
  @@index([conversationId, createdAt])
  @@index([runId, createdAt])
}

model ModelProvider {
  id          String   @id
  /// API 协议格式:anthropic | openai-responses | openai-compatible。创建后不可改。
  /// 哪些 agent 可用不落库:由 agent 侧声明的支持格式(shared AGENT_API_FORMAT_SUPPORT)派生。
  apiFormat   String
  scope       String   @default("global")
  userId      String?
  name        String
  isEnabled   Boolean  @default(false)
  baseUrl     String
  apiKey      String
  models      Json
  extraConfig Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([apiFormat, scope])
  @@index([scope, userId, name])
  @@index([userId])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Run {
  id                String       @id
  conversationId    String
  agentType         String
  runtimeType       String       @default("native")
  status            String       @default("queued")
  phase             String?
  lastSeq           Int          @default(0)
  error             String?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  // Token 用量，由 RUN_FINISHED.result 归一化写入（见 RunRecordService.recordUsage），
  // 整体对应 @agework/shared/protocol 的 RunUsage。
  usage             Json?
  // 上下文窗口占用，由 RUN_FINISHED.result 归一化写入，对应 AgentContextUsage。
  contextUsage      Json?
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  messages          Message[]
  events            RunEvent[]

  @@index([conversationId, status, createdAt])
  @@index([status, createdAt])
}

model RunEvent {
  id         String   @id
  runId      String
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runSeq     Int
  eventKey   String?
  type       String
  origin     String
  targetType String?
  targetId   String?
  chainId    String?
  refs       Json?
  summary    String?
  data       Json?
  createdAt  DateTime @default(now())

  @@unique([runId, runSeq])
  @@unique([runId, eventKey])
  @@index([runId, runSeq])
  @@index([runId, type, runSeq])
  @@index([runId, origin, runSeq])
  @@index([runId, targetType, targetId, runSeq])
  @@index([runId, chainId, runSeq])
  @@index([type, createdAt])
}

/// RuntimeHost：一台执行机器的注册行。一机一行（builtin 合并）。
/// builtin 行固定 id "builtin"，source="builtin"，能力矩阵在 capabilities 里列出
/// 所有支持的 runtimeType。registered 行由远程机器注册时创建。
model RuntimeHost {
  id              String    @id
  name            String
  source          String    @default("registered") // "registered"=远程机器注册, "builtin"=本机内置
  /// null = 全局（builtin，所有人可用），有值 = 用户私有（registered）。与
  /// ModelProvider.userId 的模式一致，但 RuntimeHost 没有单独的 scope 列——source 已经
  /// 承担了这个区分，owner 相关查询按 source 走，不是按 ownerId 是否为 null 猜测。
  ownerId         String?
  owner           User?     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  status          String    @default("offline") // 心跳存活状态，跟 removedAt 的注销语义无关
  lastHeartbeatAt DateTime?
  // registered Host 进程实例标识（注册握手上报）：同进程断线重连不变，进程重启即换新值。
  // Server 比对新旧值区分「同进程重连」与「换了进程」，后者旧 run 无从续传须判死。builtin 恒 null。
  processInstanceId String?
  // 配对 token 的 SHA-256（token 高熵随机，明文只在创建响应里出现一次）。builtin 行为 null。
  tokenHash       String?   @unique
  // 能力矩阵：{ [runtimeType]: { available, scopes, reason?, cli? } }。
  capabilities    Json?
  /// RuntimeHost 上报的 agent CLI 环境检测结果（路径/版本/认证状态）。
  /// 注册时检测上报，admin 可通过隧道 RPC 触发重检刷新。server 只存不测（见 ADR-0003）。
  envConfig       Json?
  /// 管理员手动覆盖的 CLI 路径，与 envConfig 独立存储（见 ADR-0002）。
  /// per-host per-agent 粒度：{ claude?: { executablePath }, codex?: { executablePath } }。
  envConfigOverride Json?
  /// 用户注销该 RuntimeHost 的时间；有值 = 已注销，不可再被新 Workspace 绑定，但行不物理
  /// 删除（Workspace.runtimeHostId 是必填 FK，指向的行必须一直存在）。注销时 name 会
  /// 打散（追加 id 后缀），腾出原名给用户重新注册同名机器。builtin 行恒为 null，不可注销。
  removedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspaces      Workspace[]

  @@unique([ownerId, name])
  @@index([ownerId])
}
