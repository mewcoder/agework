# 必配项
# 数据库连接，默认本地 SQLite: file:./dev.db
AGEWORK_PRIVATE_DATABASE_URL=file:./dev.db

# 可选项
# 下面配置都有代码默认值，不需要时保持注释即可。

# 应用名称，默认 AgeWork
# AGEWORK_APP_NAME=AgeWork

# 后端端口，默认 3000
# PORT=3000

# 是否托管前端静态资源，默认 false
# AGEWORK_SERVE_FRONTEND=false

# JWT 签名密钥，init 自动生成并写入，不需要手动配置
# AGEWORK_PRIVATE_JWT_SECRET=

# 首次初始化（创建超级管理员）的引导密钥，init 自动生成并写入。
# 生产环境（NODE_ENV=production）必须配置：调用 /auth/setup 时需在表单"初始密钥"
# 字段或请求体 adminInitKey 中提交一致的值，未配置或不匹配则拒绝，防止被抢注。
# AGEWORK_PRIVATE_ADMIN_INIT_KEY=

# 开发免登录，init:dev 默认 true，init:prod 默认 false
# AGEWORK_DEV_AUTH_DISABLED=true

# 允许创建的工作空间运行方式，可选 native / docker / opensandbox（可逗号组合），默认 native
# AGEWORK_RUNTIME_ALLOWED_TYPES=native

# 允许创建的 Worker 复用范围，可选 user / workspace / user,workspace，默认 user。
# 第一项是默认值；沙箱工作空间指定本地目录时必须允许并选择 workspace。
# AGEWORK_RUNTIME_ALLOWED_SCOPES=user

# OpenSandbox 配置（AGEWORK_RUNTIME_ALLOWED_TYPES 包含 opensandbox 时需要）
# AGEWORK_SANDBOX_OPENSANDBOX_DOMAIN=localhost:8080
# AGEWORK_SANDBOX_OPENSANDBOX_PROTOCOL=http
# AGEWORK_PRIVATE_OPENSANDBOX_API_KEY=
# AGEWORK_SANDBOX_OPENSANDBOX_IMAGE=agework/worker:latest
# AGEWORK_SANDBOX_OPENSANDBOX_TIMEOUT_SECONDS=3600
# AGEWORK_SANDBOX_OPENSANDBOX_USE_SERVER_PROXY=false

# 后端上下文，默认根路径，例: /agent -> /agent/api/v1
# AGEWORK_CONTEXT=/agent

# API 请求体大小限制，默认 50mb
# AGEWORK_BODY_LIMIT=50mb

# 服务日志级别，可选 debug / verbose / warn / error；未设置时 dev 输出 debug，production 输出 error/warn/log
# AGEWORK_LOG_LEVEL=debug

# AgeWork 本机数据根目录，默认 ~/.agework
# AGEWORK_DATA_DIR=

# Worker 诊断日志级别，可选 debug / info / warn / error；未设置时 dev 输出 debug，production 输出 info
# AGEWORK_WORKER_LOG_LEVEL=debug
# AGEWORK_WORKER_LOG_MAX_FILE_MB=50

# Agent 事件 raw/agui 大 payload 本地落盘，写入 ~/.agework/logs/runtime/<conversationId>.raw.jsonl 与 <conversationId>.agui.jsonl。
# 仅控制这两个 JSONL 文件是否保留完整 payload；DB 诊断索引（RunEvent）与本开关无关，始终记录。默认开启；设为 false 关闭。
# AGEWORK_AGENT_EVENT_TRACE_ENABLED=false
# AGEWORK_AGENT_EVENT_TRACE_MAX_FILE_MB=50
