{
  "name": "agework",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=api --filter=web",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:reset": "node scripts/init.mjs --dev --reset --no-install",
    "build": "turbo build",
    "start": "cross-env NODE_ENV=production AGEWORK_SERVE_FRONTEND=true pnpm --filter api start:prod",
    "start:api": "cross-env NODE_ENV=production pnpm --filter api start:prod",
    "boot": "pnpm install && node scripts/init.mjs --no-install",
    "init:dev": "node scripts/init.mjs --dev",
    "init:prod": "node scripts/init.mjs --prod",
    "app:deploy": "pnpm build && pnpm start",
    "worker:build": "node scripts/build-worker.mjs",
    "opensandbox:build": "node scripts/opensandbox.mjs rebuild",
    "opensandbox:up": "node scripts/opensandbox.mjs up",
    "opensandbox:down": "node scripts/opensandbox.mjs down",
    "opensandbox:logs": "node scripts/opensandbox.mjs logs",
    "opensandbox:health": "node scripts/opensandbox.mjs health",
    "db:push": "pnpm --filter api db:push",
    "db:reset": "pnpm --filter api db:reset",
    "db:studio": "pnpm --filter api db:studio",
    "desktop:build": "pnpm -w build && pnpm -C apps/desktop build",
    "desktop:dev": "pnpm -C apps/desktop dev",
    "desktop:dist:mac": "pnpm -C apps/desktop dist:mac",
    "desktop:dist:win": "pnpm -C apps/desktop dist:win",
    "desktop:reset": "node apps/desktop/scripts/reset-database.mjs",
    "desktop:resources": "pnpm desktop:build && pnpm -C apps/desktop prepare:resources",
    "desktop:setup": "pnpm -C apps/desktop install",
    "desktop:start": "pnpm -C apps/desktop start",
    "desktop:test": "pnpm -C apps/desktop test",
    "desktop:typecheck": "pnpm -C apps/desktop typecheck",
    "kill-port": "node scripts/kill-port.mjs",
    "link-skills": "node scripts/link-skills.mjs",
    "test:api": "pnpm --filter api test",
    "test:web": "pnpm --filter web test",
    "test:e2e": "pnpm --filter e2e test",
    "test:e2e:headed": "pnpm --filter e2e test:headed",
    "test:e2e:ui": "pnpm --filter e2e test:ui",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@clack/prompts": "^1.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.22.4",
    "turbo": "^2.9.15",
    "typescript": "~5.9"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
